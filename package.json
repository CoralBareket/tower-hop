{
  "name": "towerhop",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run dev -w @towerhop/server\" \"npm run dev -w @towerhop/client\"",
    "build": "npm run build -w @towerhop/client",
    "start": "npm start -w @towerhop/server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @towerhop/server",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9"
  }
}
